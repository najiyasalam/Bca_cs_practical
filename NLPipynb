        "# ============================================================\n",
        "# CASE STUDY - PREDICTING STUDENT EXAM PERFORMANCE\n",
        "# Cross-Validation in Model Evaluation\n",
        "# Complete Training + Outputs + Graphs\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. IMPORT LIBRARIES\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.model_selection import (\n",
        "    train_test_split,\n",
        "    KFold,\n",
        "    cross_val_score\n",
        ")\n",
        "\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.tree import DecisionTreeRegressor\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. CREATE SYNTHETIC DATASET\n",
        "# ============================================================\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "n = 500\n",
        "\n",
        "df = pd.DataFrame({\n",
        "\n",
        "    \"StudyHours\": np.random.uniform(\n",
        "        1, 10, n\n",
        "    ),\n",
        "\n",
        "    \"AttendanceRate\": np.random.uniform(\n",
        "        50, 100, n\n",
        "    ),\n",
        "\n",
        "    \"QuizScore\": np.random.uniform(\n",
        "        30, 100, n\n",
        "    )\n",
        "})\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. CREATE FINAL EXAM SCORE\n",
        "# ============================================================\n",
        "\n",
        "noise = np.random.normal(0, 5, n)\n",
        "\n",
        "df[\"FinalExamScore\"] = (\n",
        "    3.5 * df[\"StudyHours\"]\n",
        "    + 0.35 * df[\"AttendanceRate\"]\n",
        "    + 0.45 * df[\"QuizScore\"]\n",
        "    + noise\n",
        ")\n",
        "\n",
        "\n",
        "# Keep exam score between 0 and 100\n",
        "\n",
        "df[\"FinalExamScore\"] = np.clip(\n",
        "    df[\"FinalExamScore\"],\n",
        "    0,\n",
        "    100\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. DATASET OUTPUT\n",
        "# ============================================================\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"STUDENT EXAM PERFORMANCE - CASE STUDY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"\\nDATASET INFORMATION\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "print(\"Total students:\", len(df))\n",
        "\n",
        "print(\n",
        "    \"Average Final Exam Score:\",\n",
        "    round(df[\"FinalExamScore\"].mean(), 2)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Minimum Final Exam Score:\",\n",
        "    round(df[\"FinalExamScore\"].min(), 2)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Maximum Final Exam Score:\",\n",
        "    round(df[\"FinalExamScore\"].max(), 2)\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nFIRST 10 DATASET ROWS\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "print(\n",
        "    df.head(10)\n",
        "    .round(2)\n",
        "    .to_string(index=False)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. DEFINE FEATURES AND TARGET\n",
        "# ============================================================\n",
        "\n",
        "X = df[\n",
        "    [\n",
        "        \"StudyHours\",\n",
        "        \"AttendanceRate\",\n",
        "        \"QuizScore\"\n",
        "    ]\n",
        "]\n",
        "\n",
        "y = df[\"FinalExamScore\"]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. 80/20 TRAIN-TEST SPLIT\n",
        "# ============================================================\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "print(\"80/20 TRAIN-TEST SPLIT\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    \"Training dataset:\",\n",
        "    len(X_train)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Testing dataset :\",\n",
        "    len(X_test)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. DEFINE MODELS\n",
        "# ============================================================\n",
        "\n",
        "models = {\n",
        "\n",
        "    \"Linear Regression\":\n",
        "        LinearRegression(),\n",
        "\n",
        "    \"Decision Tree\":\n",
        "        DecisionTreeRegressor(\n",
        "            max_depth=5,\n",
        "            min_samples_leaf=10,\n",
        "            random_state=42\n",
        "        ),\n",
        "\n",
        "    \"Random Forest\":\n",
        "        RandomForestRegressor(\n",
        "            n_estimators=200,\n",
        "            max_depth=8,\n",
        "            min_samples_leaf=5,\n",
        "            random_state=42\n",
        "        )\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. MODEL TRAINING\n",
        "# ============================================================\n",
        "\n",
        "results = {}\n",
        "\n",
        "predictions = {}\n",
        "\n",
        "trained_models = {}\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "print(\"MODEL TRAINING\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "for name, model in models.items():\n",
        "\n",
        "    # Train model\n",
        "\n",
        "    model.fit(\n",
        "        X_train,\n",
        "        y_train\n",
        "    )\n",
        "\n",
        "\n",
        "    # Training prediction\n",
        "\n",
        "    train_prediction = model.predict(\n",
        "        X_train\n",
        "    )\n",
        "\n",
        "\n",
        "    # Prediction on unseen test data\n",
        "\n",
        "    test_prediction = model.predict(\n",
        "        X_test\n",
        "    )\n",
        "\n",
        "\n",
        "    # Save model\n",
        "\n",
        "    trained_models[name] = model\n",
        "\n",
        "    predictions[name] = test_prediction\n",
        "\n",
        "\n",
        "    # Calculate metrics\n",
        "\n",
        "    train_r2 = r2_score(\n",
        "        y_train,\n",
        "        train_prediction\n",
        "    )\n",
        "\n",
        "    test_mae = mean_absolute_error(\n",
        "        y_test,\n",
        "        test_prediction\n",
        "    )\n",
        "\n",
        "    test_rmse = np.sqrt(\n",
        "        mean_squared_error(\n",
        "            y_test,\n",
        "            test_prediction\n",
        "        )\n",
        "    )\n",
        "\n",
        "    test_r2 = r2_score(\n",
        "        y_test,\n",
        "        test_prediction\n",
        "    )\n",
        "\n",
        "\n",
        "    results[name] = [\n",
        "\n",
        "        train_r2,\n",
        "\n",
        "        test_mae,\n",
        "\n",
        "        test_rmse,\n",
        "\n",
        "        test_r2\n",
        "    ]\n",
        "\n",
        "\n",
        "    print(\n",
        "        name,\n",
        "        \"trained successfully.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. MODEL PERFORMANCE TABLE\n",
        "# ============================================================\n",
        "\n",
        "results = pd.DataFrame(\n",
        "\n",
        "    results,\n",
        "\n",
        "    index=[\n",
        "        \"Train R2\",\n",
        "        \"Test MAE\",\n",
        "        \"Test RMSE\",\n",
        "        \"Test R2\"\n",
        "    ]\n",
        "\n",
        ").T\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "print(\"MODEL PERFORMANCE RESULTS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    results.round(3).to_string()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. 5-FOLD CROSS-VALIDATION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "print(\"5-FOLD CROSS-VALIDATION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "kf = KFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "cv_scores = {}\n",
        "\n",
        "\n",
        "for name, model in models.items():\n",
        "\n",
        "    scores = cross_val_score(\n",
        "\n",
        "        model,\n",
        "\n",
        "        X_train,\n",
        "\n",
        "        y_train,\n",
        "\n",
        "        cv=kf,\n",
        "\n",
        "        scoring=\"r2\"\n",
        "    )\n",
        "\n",
        "\n",
        "    cv_scores[name] = scores.mean()\n",
        "\n",
        "\n",
        "    print(\n",
        "        \"\\n\" + name\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Fold 1 R2:\",\n",
        "        round(scores[0], 3)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Fold 2 R2:\",\n",
        "        round(scores[1], 3)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Fold 3 R2:\",\n",
        "        round(scores[2], 3)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Fold 4 R2:\",\n",
        "        round(scores[3], 3)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Fold 5 R2:\",\n",
        "        round(scores[4], 3)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Average CV R2:\",\n",
        "        round(scores.mean(), 3)\n",
        "    )\n",
        "\n",
        "\n",
        "# Add CV score to results\n",
        "\n",
        "results[\"5-Fold CV R2\"] = pd.Series(\n",
        "    cv_scores\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. FINAL MODEL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "print(\"FINAL MODEL RESULTS INCLUDING CROSS-VALIDATION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    results.round(3).to_string()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. GRAPH 1\n",
        "# ACTUAL VS PREDICTED VALUES\n",
        "# ============================================================\n",
        "\n",
        "best_model_name = results[\n",
        "    \"Test R2\"\n",
        "].idxmax()\n",
        "\n",
        "\n",
        "best_predictions = predictions[\n",
        "    best_model_name\n",
        "]\n",
        "\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "\n",
        "plt.scatter(\n",
        "    y_test,\n",
        "    best_predictions,\n",
        "    alpha=0.7\n",
        ")\n",
        "\n",
        "\n",
        "plt.plot(\n",
        "    [y_test.min(), y_test.max()],\n",
        "    [y_test.min(), y_test.max()],\n",
        "    \"--\"\n",
        ")\n",
        "\n",
        "\n",
        "plt.xlabel(\n",
        "    \"Actual Final Exam Score\"\n",
        ")\n",
        "\n",
        "plt.ylabel(\n",
        "    \"Predicted Final Exam Score\"\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    f\"Actual vs Predicted Scores - {best_model_name}\"\n",
        ")\n",
        "\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "\n",
        "plt.savefig(\n",
        "    \"Figure_1_Actual_vs_Predicted.png\",\n",
        "    dpi=300\n",
        ")\n",
        "\n",
        "\n",
        "plt.show()\n",
